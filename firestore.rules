rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu items collection - readable by all visitors in real-time, writable by admin/manager
    match /menu_items/{itemId} {
      allow read, write: if true;
    }
    
    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    
    // Restaurant Settings (configuration, admin PIN/password, banner, hours)
    match /settings/{settingId} {
      allow read, write: if true;
    }
    
    // Orders collection (if customers submit orders or tracking)
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
