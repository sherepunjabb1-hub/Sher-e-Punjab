{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "A food or drink dish available on the restaurant menu.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameEs": { "type": "string" },
        "nameEn": { "type": "string" },
        "descriptionEs": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "isVegetarian": { "type": "boolean" },
        "isVegan": { "type": "boolean" },
        "isGlutenFree": { "type": "boolean" },
        "spicyLevel": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "isChefSpecial": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "image": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nameEs", "nameEn", "price", "category", "isAvailable"]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category definition for organizing dishes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameEs": { "type": "string" },
        "nameEn": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" },
        "descriptionEs": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nameEs", "nameEn", "order"]
    },
    "AdminSetting": {
      "title": "AdminSetting",
      "description": "Restaurant administrative and authentication configuration.",
      "type": "object",
      "properties": {
        "password": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "RestaurantBranding": {
      "title": "RestaurantBranding",
      "description": "Custom restaurant logo and hero background visual branding assets.",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "heroBgUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/menu_items/{itemId}": {
      "schema": "MenuItem",
      "description": "All menu items and dish catalog for Sher E Punjab."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Menu categories taxonomy."
    },
    "/settings/{settingId}": {
      "schema": "AdminSetting",
      "description": "Restaurant configuration, branding assets, and admin settings."
    }
  }
}
